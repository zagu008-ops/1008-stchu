+// Keep catalog reads on the same server path as image generation (no browser CORS).
+comfy.post('/object-info', async (request, response) => {
+    try {
+        const url = new URL(urlJoin(request.body.url, '/object_info'));
+        const result = await fetch(url, { signal: AbortSignal.timeout(15000) });
+        if (!result.ok) return response.status(502).send('ComfyUI catalog returned ' + result.status);
+        return response.json(await result.json());
+    } catch (error) {
+        console.error('ComfyUI catalog:', error.message);
+        return response.status(502).send('Unable to read ComfyUI catalog: ' + error.message);
+    }
+});
+
+comfy.post('/loras', async (request, response) => {
+    try {
+        const url = new URL(urlJoin(request.body.url, '/object_info'));
+        const result = await fetch(url, { signal: AbortSignal.timeout(15000) });
+        if (!result.ok) return response.status(502).send('ComfyUI returned an error.');
+        const data = await result.json();
+        const names = Object.values(data).flatMap(node => {
+            const options = node?.input?.required?.lora_name?.[0] ?? node?.input?.optional?.lora_name?.[0];
+            return Array.isArray(options) ? options.filter(name => typeof name === 'string') : [];
+        });
+        return response.json([...new Set(names)].sort());
+    } catch (error) {
+        console.error(error);
+        return response.status(502).send('Unable to read ComfyUI LoRA list.');
+    }
+});
+
